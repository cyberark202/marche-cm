# Copier en terraform.tfvars (gitignoré) et renseigner.
aws_region  = "eu-north-1"
aws_profile = "central-market"
environment = "prod"

cluster_name       = "marche-cm"
kubernetes_version = "1.30"

# Réutiliser le VPC où vit RDS (sinon les pods ne joignent pas la base).
vpc_id             = "vpc-xxxxxxxx"
private_subnet_ids = ["subnet-aaaa", "subnet-bbbb"]
public_subnet_ids  = ["subnet-cccc", "subnet-dddd"]

node_instance_types = ["t3.large"]
node_min_size       = 2
node_max_size       = 4
node_desired_size   = 2

media_bucket_name = "market-cm"
ssm_prefix        = "/marche-cm/prod"

# ARNs IAM à promouvoir admin du cluster (toi / le rôle CI).
cluster_admin_principals = [
  # "arn:aws:iam::958924735829:user/ton-user",
]
